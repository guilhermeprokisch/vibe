#!/usr/bin/env bash
# vibe — parallel feature worktrees (with optional agent orchestration) for any git repo.
#
# A vibe is an isolated git worktree per feature (branch namespaced by the base it forked
# from). Core lifecycle is git-only: new / ls / cd / pull / finish. On top of that, an
# optional agent layer (code / chat and the live `ls` board) integrates with
#   herdr        (https://herdr.dev)   — run/observe agents in panes
#   sessiongrep                        — past agent session history
# Each is used only when its command is invoked, and degrades gracefully if absent.
#
# Config (git config keys, overridable by env):
#   vibe.dir    / VIBE_DIR        worktrees parent dir (default ../<repo>-wt)
#   vibe.prefix / VIBE_PREFIX     branch namespace      (default "vibe")
#   vibe.shell  / VIBE_SHELL_CMD  command to open in a worktree (default: auto)
#   vibe.remote / VIBE_REMOTE     remote name           (default "origin")
#   vibe.agent  / VIBE_AGENT      agent command for `code` (default "claude")
set -euo pipefail

# VIBE_PROG lets a wrapper (e.g. the Nix package) set the displayed name, since a
# shebang script's $0 is the (wrapped) file path, not the invoked command name.
PROG="${VIBE_PROG:-$(basename "$0")}"

# ---- helpers ---------------------------------------------------------------

die()  { echo "${PROG}: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

cfg() { # cfg <git-config-key> <var-name> <default>
  local v
  v="$(git config "$1" 2>/dev/null || true)"
  [ -z "$v" ] && [ -n "${2:-}" ] && v="${!2-}"
  [ -z "$v" ] && v="$3"
  printf '%s' "$v"
}

# Source a committed per-project .vibe.sh (repo root): sets VIBE_* defaults and hooks
# (vibe_setup / vibe_teardown).
load_project_config() {
  local f; f="$(main_root 2>/dev/null)/.vibe.sh"
  [ -f "$f" ] && . "$f"
  return 0
}

# Run a hook (if defined) with VIBE_WORKTREE/VIBE_BASE/VIBE_BRANCH/VIBE_NAME exported;
# anything it exports propagates into the shell/agent vibe then launches.
run_hook() { # run_hook <fn> <worktree> <base> <branch> [name]
  declare -F "$1" >/dev/null 2>&1 || return 0
  export VIBE_WORKTREE="$2" VIBE_BASE="$3" VIBE_BRANCH="$4" VIBE_NAME="${5:-$(basename "$2")}"
  "$1"
}

remote() { cfg vibe.remote VIBE_REMOTE origin; }

# Registry of repos vibe has touched (for `ls --all`). Auto-populated on every run.
registry_file() { printf '%s/vibe/projects' "${XDG_STATE_HOME:-$HOME/.local/state}"; }
register_project() {
  local root="${1:-}" f; [ -n "$root" ] || return 0; f="$(registry_file)"
  mkdir -p "$(dirname "$f")" 2>/dev/null || true
  grep -qxF "$root" "$f" 2>/dev/null || printf '%s\n' "$root" >> "$f"
}
# All repos for --all: registry (existing dirs) + repos with a live herdr agent, deduped.
all_repos() {
  local f; f="$(registry_file)"
  {
    [ -f "$f" ] && cat "$f"
    if have herdr && have jq; then
      herdr agent list 2>/dev/null | jq -r '.result.agents[]?.cwd // empty' 2>/dev/null \
        | while IFS= read -r c; do [ -d "$c" ] && ( cd "$c" 2>/dev/null && main_root ); done
    fi
  } | while IFS= read -r r; do [ -n "$r" ] && [ -d "$r" ] && printf '%s\n' "$r"; done | awk '!seen[$0]++'
}

main_root() {
  local g; g="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$g" in /*) : ;; *) g="$(pwd)/$g" ;; esac
  (cd "$(dirname "$g")" && pwd -P)
}
repo_name() { basename "$(main_root)"; }
worktrees_dir() {
  local d; d="$(cfg vibe.dir VIBE_DIR "")"
  if [ -n "$d" ]; then printf '%s' "$d"; else printf '%s/%s-wt' "$(dirname "$(main_root)")" "$(repo_name)"; fi
}
slugify() {
  local s; s="$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')"
  [ -z "$s" ] && s="wt"; printf '%s' "$s"
}
slug_from_prompt() {
  local s; s="$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-32 | sed 's/-*$//')"
  [ -n "$s" ] && printf '%s' "$s" || printf 'vibe'
}
current_branch() {
  local b; b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ -n "$b" ] && [ "$b" != "HEAD" ] && printf '%s' "$b"
}

# Worktree path on <branch> (empty if none).
wt_for_branch() {
  local target="$1" repo="${2:-$(main_root)}" path
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) path="${line#worktree }" ;;
      branch\ *) [ "${line#branch refs/heads/}" = "$target" ] && { printf '%s' "$path"; return 0; } ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain)
  return 1
}

# Worktree path matching <name> (exact dir-name, else first substring). Empty if none.
resolve_worktree() {
  local q="$1" root; root="$(main_root)" || return 1
  git -C "$root" worktree list --porcelain | awk -v q="$q" '
    /^worktree /{ p=substr($0,10); b=p; sub(/.*\//,"",b);
      if (b==q){ print p; exit }
      if (cand=="" && index(b,q)){ cand=p } }
    END{ if (cand!="") print cand }'
}

# herdr agent targets as: status<TAB>cwd  (empty if herdr/jq absent or no server).
agent_map() {
  have herdr && have jq || return 0
  herdr agent list 2>/dev/null \
    | jq -r '.result.agents[]? | [(.agent_status // .status // "unknown"), ((.cwd // .foreground_cwd // "")|ascii_downcase)] | @tsv' 2>/dev/null || true
}
# Recent sessions as: recency<TAB>cwd  (empty if sessiongrep absent).
session_rows() {
  have sessiongrep || return 0
  # Emits: recency<TAB>provider<TAB>cwd  (provider = claude/codex/cursor/…).
  sessiongrep list --limit "${VIBE_HISTORY_SCAN:-500}" 2>/dev/null | awk -F'  +' '
    /^[[:space:]]+cwd=/ { if (havep){ c=$0; sub(/.*cwd=/,"",c); sub(/[[:space:]]+preview=.*/,"",c); print rtime "\t" rprov "\t" tolower(c) } havep=0; next }
    /^[^[:space:]]/ { rtime=$1; rprov=$2; havep=1 }'
}

# Most-recent session provider (claude/codex/…) under <path>, via sessiongrep.
provider_for_path() {
  have sessiongrep || return 0
  sessiongrep list --path "$1" --limit 1 2>/dev/null | awk -F'  +' '/^[^[:space:]]/{print $2; exit}'
}

# Resume command for an agent launch cmd (override via git config vibe.resume.<bin>).
resume_cmd_for() {
  local cmd="$1" bin; bin="$(basename "${cmd%% *}")"
  local ov; ov="$(git config "vibe.resume.${bin}" 2>/dev/null || true)"
  if [ -n "$ov" ]; then printf '%s' "$ov"; return; fi
  case "$bin" in
    claude) printf 'claude --continue' ;;
    codex)  printf 'codex resume --last' ;;
    gemini) printf 'gemini' ;;
    *)      printf '%s' "$cmd" ;;
  esac
}
state_glyph() {
  case "$1" in
    working) printf '● working' ;; blocked) printf '◍ blocked' ;;
    done) printf '✓ done' ;; idle) printf '· idle' ;;
    "") printf '–' ;; *) printf '? %s' "$1" ;;
  esac
}

# Open the configured/auto-detected dev shell in <dir>; export VIBE_BASE=<base>.
open_in() {
  local dir="$1" base="$2" cmd
  cd "$dir" || die "cannot cd $dir"
  export VIBE_BASE="$base"
  cmd="$(cfg vibe.shell VIBE_SHELL_CMD "")"
  if [ -n "$cmd" ]; then
    echo "Entering $dir (run 'exit' to return)..."; exec "${SHELL:-bash}" -c "$cmd"
  elif [ -f "$dir/flake.nix" ] && have nix; then
    echo "Entering $dir nix dev shell (run 'exit' to return)..."; exec nix develop --command "${SHELL:-bash}"
  else
    echo "Entering $dir (run 'exit' to return)..."; exec "${SHELL:-bash}" -i
  fi
}

# Create a worktree+branch for <name> off [base]; run vibe_setup. Sets NEW_PATH/
# NEW_BRANCH/NEW_BASE in the CURRENT shell (so vibe_setup's exports survive).
NEW_PATH=""; NEW_BRANCH=""; NEW_BASE=""
create_worktree() {
  local name="$1" base="${2:-}"
  if [ -z "$base" ]; then base="$(current_branch)"; [ -z "$base" ] && base="$(cfg init.defaultBranch '' main)"; fi
  local root rem prefix slug branch wtdir path start
  root="$(main_root)" || die "not inside a git repo"
  rem="$(remote)"; prefix="$(cfg vibe.prefix VIBE_PREFIX vibe)"; slug="$(slugify "$name")"
  # Namespaced branch <prefix>/<base>/<name> records its origin; the prefix prevents a
  # git D/F conflict (a ref can't nest under an existing branch). Base slashes flattened.
  branch="${prefix}/${base//\//-}/${name}"
  wtdir="$(worktrees_dir)"; path="${wtdir}/${slug}"
  [ -e "$path" ] && die "path already exists: $path"
  mkdir -p "$wtdir"
  echo "Fetching ${rem}/${base}..." >&2
  git -C "$root" fetch "$rem" "$base" >/dev/null 2>&1 || true
  start="${rem}/${base}"; git -C "$root" rev-parse --verify --quiet "$start" >/dev/null 2>&1 || start="$base"
  echo "Creating worktree $path on $branch (from $start)..." >&2
  git -C "$root" worktree add -b "$branch" "$path" "$start" >&2
  git -C "$root" config "branch.${branch}.vibeBase" "$base"
  run_hook vibe_setup "$path" "$base" "$branch" "$name" >&2 || true
  NEW_PATH="$path"; NEW_BRANCH="$branch"; NEW_BASE="$base"
}

# ---- commands --------------------------------------------------------------

cmd_new() {
  local name="" base="" do_cd="true"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) base="${2:?--from needs a branch}"; shift 2 ;; --from=*) base="${1#*=}"; shift ;;
      --no-cd) do_cd="false"; shift ;;
      -*) die "unknown option for new: $1" ;;
      *) [ -z "$name" ] && name="$1" || die "unexpected arg: $1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: ${PROG} new <name> [--from <base>] [--no-cd]"
  create_worktree "$name" "$base"
  cat <<EOF

Worktree ready: $NEW_PATH
  Branch: $NEW_BRANCH  (base: $NEW_BASE)
EOF
  [ "$do_cd" = "true" ] && [ -t 1 ] && open_in "$NEW_PATH" "$NEW_BASE"
}

# code "<prompt>" [--name x] [--from base] [--agent cmd] : worktree + an agent on the prompt
cmd_code() {
  local prompt="" name="" from="" agent=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) name="${2:?}"; shift 2 ;; --name=*) name="${1#*=}"; shift ;;
      --from) from="${2:?}"; shift 2 ;; --from=*) from="${1#*=}"; shift ;;
      --agent) agent="${2:?}"; shift 2 ;; --agent=*) agent="${1#*=}"; shift ;;
      -*) die "unknown option for code: $1" ;;
      *) [ -z "$prompt" ] && prompt="$1" || die "unexpected arg: $1"; shift ;;
    esac
  done
  [ -n "$prompt" ] || die "usage: ${PROG} code \"<prompt>\" [--name x] [--from base] [--agent cmd]"
  have herdr || die "herdr not found — needed to run agents (https://herdr.dev)"
  [ -z "$name" ] && name="$(slug_from_prompt "$prompt")"
  agent="${agent:-$(cfg vibe.agent VIBE_AGENT claude)}"
  create_worktree "$name" "$from"
  # Record the agent so `chat` knows what to restore later.
  git -C "$(main_root)" config "branch.${NEW_BRANCH}.vibeAgent" "$agent" 2>/dev/null || true
  echo "Starting agent: ${agent} \"${prompt}\""
  herdr agent start "$name" --cwd "$NEW_PATH" --no-focus -- ${agent} "$prompt" >/dev/null 2>&1 \
    || die "herdr agent start failed — is the server running? ('herdr status')"
  cat <<EOF

Vibe '$name' is running (branch $NEW_BRANCH).
  chat:    ${PROG} chat $name        (attach to the agent)
  board:   ${PROG} ls
  finish:  ${PROG} finish $name
EOF
}

# The board: each vibe with its agent model, state, session history.
# `--all` (-a) spans every project (registry + herdr-active repos), with a PROJECT column.
cmd_ls() {
  local all="false" watch="false" interval="2" slow_every="${VIBE_WATCH_FULL:-10}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all|-a) all="true" ;;
      --watch|-w) watch="true" ;;
      --interval|-n) interval="${2:?-n needs seconds}"; shift ;;
      --interval=*) interval="${1#*=}" ;;
      *) die "unknown option for ls: $1" ;;
    esac; shift
  done

  # Persist across watch ticks: WR/WB/WN/WL + precomputed WMODEL/WHIST (slow), WSTATE (fast).
  local -a WR WB WN WL WMODEL WHIST WSTATE
  local RIDX
  _wt_index() {  # longest worktree-path prefix of <lowercased cwd + '/'> → RIDX (no fork)
    local clc="$1" i bestlen=0; RIDX=-1
    for i in "${!WL[@]}"; do
      case "$clc" in "${WL[$i]}"/*) if [ "${#WL[$i]}" -gt "$bestlen" ]; then bestlen="${#WL[$i]}"; RIDX="$i"; fi ;; esac
    done
  }

  # SLOW: worktrees + per-row MODEL + HISTORY (git + sessiongrep). Recomputed occasionally.
  _refresh_slow() {
    WR=(); WB=(); WN=(); WL=(); WMODEL=(); WHIST=(); WSTATE=()
    local -a WCNT=() WFIRST=() WPROV=()
    _collect() {
      local repo="$1" path="" branch=""
      while IFS= read -r line; do
        case "$line" in
          worktree\ *) path="${line#worktree }" ;;
          branch\ *)
            branch="${line#branch refs/heads/}"
            WR+=("$repo"); WB+=("$branch"); WN+=("$(basename "$path")")
            WL+=("$(printf '%s' "$path" | tr 'A-Z' 'a-z')"); WCNT+=(0); WFIRST+=(""); WPROV+=(""); WSTATE+=("")
            ;;
        esac
      done < <(git -C "$repo" worktree list --porcelain 2>/dev/null)
    }
    if [ "$all" = "true" ]; then local r; while IFS= read -r r; do _collect "$r"; done < <(all_repos)
    else _collect "$(main_root)" || die "not inside a git repo"; fi
    local t prov c
    while IFS=$'\t' read -r t prov c; do
      [ -n "$c" ] || continue
      _wt_index "${c}/"
      if [ "$RIDX" -ge 0 ]; then
        WCNT[$RIDX]=$(( WCNT[RIDX] + 1 ))
        [ -z "${WFIRST[$RIDX]}" ] && WFIRST[$RIDX]="$t"
        [ -z "${WPROV[$RIDX]}" ] && WPROV[$RIDX]="$prov"
      fi
    done < <(session_rows)
    local i model
    for i in "${!WR[@]}"; do
      model="$(git -C "${WR[$i]}" config "branch.${WB[$i]}.vibeAgent" 2>/dev/null || true)"
      model="$(basename "${model%% *}" 2>/dev/null)"
      [ -z "$model" ] && model="${WPROV[$i]}"
      [ -z "$model" ] && model="–"
      WMODEL[$i]="$model"
      if [ "${WCNT[$i]}" -gt 0 ]; then WHIST[$i]="${WCNT[$i]} · ${WFIRST[$i]}"; else WHIST[$i]="–"; fi
    done
  }

  # FAST: just the live agent state from herdr (≈instant) — re-run every watch tick.
  _refresh_state() {
    local i; for i in "${!WR[@]}"; do WSTATE[$i]=""; done
    local st cwd
    while IFS=$'\t' read -r st cwd; do
      [ -n "$cwd" ] || continue
      _wt_index "${cwd}/"
      [ "$RIDX" -ge 0 ] && [ -z "${WSTATE[$RIDX]}" ] && WSTATE[$RIDX]="$st"
    done < <(agent_map)
  }

  _render() {
    local i
    if [ "$all" = "true" ]; then printf '%-20s %-26s %-10s %-12s %s\n' "PROJECT" "VIBE" "MODEL" "STATE" "HISTORY"
    else printf '%-30s %-10s %-12s %s\n' "VIBE" "MODEL" "STATE" "HISTORY"; fi
    for i in "${!WR[@]}"; do
      if [ "$all" = "true" ]; then
        printf '%-20s %-26s %-10s %-12s %s\n' "$(basename "${WR[$i]}")" "${WN[$i]}" "${WMODEL[$i]}" "$(state_glyph "${WSTATE[$i]}")" "${WHIST[$i]}"
      else
        printf '%-30s %-10s %-12s %s\n' "${WN[$i]}" "${WMODEL[$i]}" "$(state_glyph "${WSTATE[$i]}")" "${WHIST[$i]}"
      fi
    done
  }

  if [ "$watch" = "true" ]; then
    have tput && tput civis 2>/dev/null || true
    trap 'have tput && tput cnorm 2>/dev/null; echo; exit 0' INT TERM
    local firstrun=1 last=0 now
    while :; do
      now=$SECONDS
      if [ "$firstrun" = 1 ] || [ $(( now - last )) -ge "$slow_every" ]; then _refresh_slow; last=$now; firstrun=0; fi
      _refresh_state
      printf '\033[H\033[2J'
      printf 'vibe board — %s  (state every %ss · full every %ss · Ctrl-C to stop)\n\n' "$(date +%H:%M:%S)" "$interval" "$slow_every"
      _render
      sleep "$interval" || break
    done
    have tput && tput cnorm 2>/dev/null || true
  else
    _refresh_slow; _refresh_state; _render
  fi
}

# herdr agent NAME running in <worktree-path> (empty if none / herdr absent).
agent_for_path() {
  have herdr && have jq || return 0
  herdr agent list 2>/dev/null | jq -r --arg p "$1" '
    .result.agents[]? | select(((.cwd // "")|ascii_downcase)==($p|ascii_downcase)
      or (((.cwd // "")|ascii_downcase)|startswith(($p|ascii_downcase)+"/"))) | .name' 2>/dev/null | head -1
}

# Open a dev shell in <path> (or print the path when not a TTY, for `cd "$(…)"`).
_open_worktree() {
  local path="$1" root branch base
  root="$(main_root)"
  branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  base="$(git -C "$root" config "branch.${branch}.vibeBase" 2>/dev/null || true)"
  if [ -t 1 ]; then run_hook vibe_setup "$path" "$base" "$branch" >/dev/null 2>&1 || true; open_in "$path" "$base"
  else printf '%s\n' "$path"; fi
}

# chat: talk to the vibe's agent — attach if it's running, else restore (resume) it.
cmd_chat() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: ${PROG} chat <name|branch>"
  have herdr || die "herdr not found — needed to run/attach agents (https://herdr.dev)"
  local root path; root="$(main_root)" || die "not inside a git repo"
  path="$(resolve_worktree "$name")"
  [ -n "$path" ] || die "no worktree matching '$name' (see: ${PROG} ls)"

  # 1) already running → attach
  local agent; agent="$(agent_for_path "$path")"
  if [ -n "$agent" ]; then
    [ -t 1 ] || { echo "agent '$agent' is running in $path"; return 0; }
    echo "Attaching to agent '$agent' (detach to leave)..."; exec herdr agent attach "$agent"
  fi

  # 2) not running → restore: relaunch the recorded agent (resume), re-establishing env
  local wtname branch base acmd resume
  wtname="$(basename "$path")"
  branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  base="$(git -C "$root" config "branch.${branch}.vibeBase" 2>/dev/null || true)"
  acmd="$(git -C "$root" config "branch.${branch}.vibeAgent" 2>/dev/null || true)"
  [ -z "$acmd" ] && acmd="$(provider_for_path "$path")"
  [ -z "$acmd" ] && acmd="$(cfg vibe.agent VIBE_AGENT claude)"
  resume="$(resume_cmd_for "$acmd")"
  echo "Restoring agent in $path: ${resume}"
  run_hook vibe_setup "$path" "$base" "$branch" >/dev/null 2>&1 || true
  herdr agent start "$wtname" --cwd "$path" --no-focus -- ${resume} >/dev/null 2>&1 \
    || die "herdr agent start failed — 'herdr status'?"
  [ -t 1 ] || { echo "Restored agent '$wtname'."; return 0; }
  exec herdr agent attach "$wtname"
}

# shell / cd: open a plain dev shell in the worktree (or print the path when not a TTY).
cmd_shell() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: ${PROG} shell <name|branch>"
  local path; path="$(resolve_worktree "$name")"
  [ -n "$path" ] || die "no worktree matching '$name' (see: ${PROG} ls)"
  _open_worktree "$path"
}

cmd_pull() {
  local arg="${1:-}"; [ -n "$arg" ] || die "usage: ${PROG} pull <branch|worktree>"
  local cur ref root rem; root="$(main_root)"; rem="$(remote)"
  cur="$(current_branch)" || die "detached HEAD — checkout a branch first"
  [ -n "$(git status --porcelain)" ] && die "uncommitted changes — commit or stash first"
  if git rev-parse --verify --quiet "${arg}^{commit}" >/dev/null 2>&1; then ref="$arg"
  elif [ -n "$(wt_for_branch "$arg" "$root" 2>/dev/null)" ]; then ref="$(git -C "$(wt_for_branch "$arg" "$root")" rev-parse --abbrev-ref HEAD)"
  elif git rev-parse --verify --quiet "${rem}/${arg}^{commit}" >/dev/null 2>&1; then ref="${rem}/${arg}"
  else die "could not resolve '$arg'"; fi
  [ "$ref" = "$cur" ] && die "'$ref' is the current branch"
  echo "Fetching ${rem}..."; git fetch "$rem" >/dev/null 2>&1 || true
  echo "Merging $ref into $cur..."
  if git merge --no-edit "$ref"; then echo "Merged $ref cleanly."; else
    echo "" >&2; echo "Conflicts in:" >&2; git diff --name-only --diff-filter=U | sed 's/^/  /' >&2
    echo >&2; echo "Resolve then 'git add … && git commit', or 'git merge --abort'." >&2; return 1
  fi
}

# finish [<name>] [--no-merge] [--base b] [--force] : finish a worktree (by name, or the
# current one): close its agent pane, PR + squash-merge, remove it, fast-forward the base.
cmd_finish() {
  local do_merge="true" force="false" base="" target=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-merge) do_merge="false" ;; --force) force="true" ;;
      --base) base="${2:?--base needs a branch}"; shift ;; --base=*) base="${1#*=}" ;;
      -*) die "unknown option for finish: $1" ;;
      *) [ -z "$target" ] && target="$1" || die "unexpected arg: $1" ;;
    esac; shift
  done
  local root rem here branch; root="$(main_root)"; rem="$(remote)"
  if [ -n "$target" ]; then here="$(resolve_worktree "$target")"; [ -n "$here" ] || die "no worktree matching '$target'"; else here="$(pwd -P)"; fi
  here="$(cd "$here" && pwd -P)"
  branch="$(git -C "$here" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ -n "$branch" ] && [ "$branch" != HEAD ] || die "detached HEAD in $here"
  [ "$here" = "$root" ] && die "refusing to finish the primary checkout"
  case "$branch" in main|master) die "refusing to finish '$branch'" ;; esac
  [ -n "$(git -C "$here" status --porcelain)" ] && [ "$force" != "true" ] && die "uncommitted/untracked changes in $here — commit, or pass --force"
  [ -z "$base" ] && base="$(git -C "$root" config "branch.${branch}.vibeBase" 2>/dev/null || true)"
  [ -z "$base" ] && base="$(cfg init.defaultBranch '' main)"

  echo "Finishing $branch into $base."
  echo "Pushing $branch..."; git -C "$here" push -u "$rem" "$branch"

  if [ "$do_merge" = "true" ]; then
    have gh || die "gh not found — merge manually then re-run with --no-merge"
    local pr; pr="$(gh pr list --head "$branch" --state open --json number -q '.[0].number' 2>/dev/null || true)"
    if [ -z "$pr" ]; then
      echo "Creating PR for $branch against $base..."
      gh pr create --base "$base" --head "$branch" --fill
      pr="$(gh pr list --head "$branch" --state open --json number -q '.[0].number' 2>/dev/null || true)"
    fi
    [ -n "$pr" ] || die "could not find/create an open PR for $branch"
    local m="UNKNOWN" n=0
    while [ "$n" -lt 10 ]; do m="$(gh pr view "$pr" --json mergeable -q .mergeable 2>/dev/null || echo UNKNOWN)"; [ "$m" != UNKNOWN ] && break; sleep 2; n=$((n+1)); done
    [ "$m" = CONFLICTING ] && die "PR #$pr conflicts with $base — '${PROG} pull $base' in the worktree, resolve, push, retry"
    echo "Merging PR #$pr (squash)..."
    gh pr merge "$pr" --squash
    git -C "$root" push "$rem" --delete "$branch" >/dev/null 2>&1 || true
  fi

  # Close the agent's herdr workspace (if any) for this worktree.
  if have herdr && have jq; then
    local ws
    ws="$(herdr agent list 2>/dev/null | jq -r --arg p "$here" '.result.agents[]? | select(((.cwd // "")|ascii_downcase)==($p|ascii_downcase) or (((.cwd // "")|ascii_downcase)|startswith(($p|ascii_downcase)+"/"))) | .workspace_id' | head -1)"
    [ -n "$ws" ] && { echo "Closing herdr workspace $ws..."; herdr workspace close "$ws" >/dev/null 2>&1 || true; }
  fi

  run_hook vibe_teardown "$here" "$base" "$branch" || true

  cd "$root"
  local rmflag=""; [ "$force" = "true" ] && rmflag="--force"
  echo "Removing worktree $here..."
  git -C "$root" worktree remove $rmflag "$here"
  git -C "$root" branch -D "$branch" >/dev/null 2>&1 || true

  local base_wt=""
  if [ "$do_merge" = "true" ]; then
    git -C "$root" fetch "$rem" "$base" >/dev/null 2>&1 || true
    base_wt="$(wt_for_branch "$base" "$root" || true)"
    if [ -n "$base_wt" ]; then
      if git -C "$base_wt" merge --ff-only "${rem}/${base}" >/dev/null 2>&1; then echo "Fast-forwarded $base in $base_wt."
      else echo "Note: couldn't auto-update $base in $base_wt — pull it manually." >&2; fi
    else git -C "$root" fetch "$rem" "${base}:${base}" >/dev/null 2>&1 && echo "Updated local $base." || true; fi
  fi
  echo
  if [ "$do_merge" = "true" ]; then echo "Done. '$branch' merged into $base; worktree removed and $base updated locally."
  else echo "Done. '$branch' pushed; worktree removed (not merged — --no-merge)."; fi
  echo "Base checkout: ${base_wt:-$root}"
}

# rm [<name>] [--force] [--keep-branch] : remove a vibe (worktree + branch) WITHOUT finishing.
cmd_rm() {
  local force="false" keepbranch="false" target=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force="true" ;; --keep-branch) keepbranch="true" ;;
      -*) die "unknown option for rm: $1" ;;
      *) [ -z "$target" ] && target="$1" || die "unexpected arg: $1" ;;
    esac; shift
  done
  local root here branch; root="$(main_root)" || die "not inside a git repo"
  if [ -n "$target" ]; then here="$(resolve_worktree "$target")"; [ -n "$here" ] || die "no worktree matching '$target' (see: ${PROG} ls)"; else here="$(pwd -P)"; fi
  here="$(cd "$here" && pwd -P)"
  branch="$(git -C "$here" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ "$here" = "$root" ] && die "refusing to remove the primary checkout"
  case "$branch" in main|master) die "refusing to remove '$branch'" ;; esac
  [ -n "$(git -C "$here" status --porcelain)" ] && [ "$force" != "true" ] && die "uncommitted/untracked changes in $here — commit, or pass --force to discard"

  # Close the agent's pane + run the project teardown hook before removal.
  if have herdr && have jq; then
    local ws
    ws="$(herdr agent list 2>/dev/null | jq -r --arg p "$here" '.result.agents[]? | select(((.cwd // "")|ascii_downcase)==($p|ascii_downcase) or (((.cwd // "")|ascii_downcase)|startswith(($p|ascii_downcase)+"/"))) | .workspace_id' | head -1)"
    [ -n "$ws" ] && { echo "Closing herdr workspace $ws..."; herdr workspace close "$ws" >/dev/null 2>&1 || true; }
  fi
  run_hook vibe_teardown "$here" "" "$branch" || true

  cd "$root"
  local rmflag=""; [ "$force" = "true" ] && rmflag="--force"
  echo "Removing worktree $here..."
  git -C "$root" worktree remove $rmflag "$here"

  if [ "$keepbranch" = "true" ]; then
    echo "Kept branch '$branch'."
  elif [ -n "$branch" ] && [ "$branch" != HEAD ]; then
    if git -C "$root" branch -d "$branch" 2>/dev/null; then echo "Deleted branch '$branch'."
    elif [ "$force" = "true" ]; then git -C "$root" branch -D "$branch" >/dev/null 2>&1 && echo "Force-deleted branch '$branch'."
    else echo "Kept branch '$branch' — it has unmerged commits. Re-run with --force to delete it (or it stays safe in git)."; fi
  fi
  echo "Done. Removed vibe '$(basename "$here")'."
}

usage() {
  cat <<EOF
${PROG} — parallel feature worktrees (with optional agent orchestration) for any git repo

Usage: ${PROG} <command> [args]

  new <name> [--from b] [--no-cd]   Create a worktree + branch vibe/<base>/<name>, open a shell
  code "<prompt>" [opts]            Create a worktree and start an agent on the prompt
                                    (opts: --name x, --from b, --agent cmd)
  ls [--all|-a] [--watch|-w [-n S]]  (alias: board)
                                    The board: each vibe with its agent model, state, history.
                                    --all spans every project (PROJECT column) — registry of
                                    repos vibe has touched, plus any repo with a live agent.
                                    --watch redraws every S seconds (default 2) for live state.
  chat <name>   (alias: attach)     Talk to the vibe's agent: attach if running, else resume it
  shell <name>  (alias: cd)         Open a plain dev shell in a worktree
  pull <ref>                        Merge another feature into the current branch
  finish [<name>] [opts]            Close the agent pane, PR + squash-merge, remove the
                                    worktree, fast-forward the base (opts: --no-merge,
                                    --base b, --force). No <name> = the current worktree.
  rm [<name>] [--force] [--keep-branch]
                                    Remove a vibe (worktree + branch) WITHOUT finishing.
                                    Refuses to discard uncommitted/unmerged work unless --force.

Core (new/ls/cd/pull/finish) needs only git (+ gh for finish). The agent layer
(code/chat and the live ls columns) uses herdr / sessiongrep / jq when present.

Config (git config or env): vibe.dir/VIBE_DIR, vibe.prefix/VIBE_PREFIX,
  vibe.shell/VIBE_SHELL_CMD, vibe.remote/VIBE_REMOTE, vibe.agent/VIBE_AGENT (default claude),
  VIBE_HISTORY_SCAN. Per-project .vibe.sh (sourced) can set these + hooks vibe_setup/vibe_teardown.
EOF
}

main() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
  load_project_config
  register_project "$(main_root 2>/dev/null)"   # remember this repo for `ls --all`
  local sub="${1:-}"; shift || true
  case "$sub" in
    new) cmd_new "$@" ;;
    code) cmd_code "$@" ;;
    ls|list|board) cmd_ls "$@" ;;
    chat|attach) cmd_chat "$@" ;;
    shell|cd) cmd_shell "$@" ;;
    pull) cmd_pull "$@" ;;
    finish) cmd_finish "$@" ;;
    rm) cmd_rm "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "${PROG}: unknown command: $sub" >&2; usage; exit 1 ;;
  esac
}

main "$@"
